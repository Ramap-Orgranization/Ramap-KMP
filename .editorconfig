root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.kt,*.kts}]
max_line_length = off
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_package-name = disabled
ktlint_standard_function-naming = disabled

[**/build/generated/**/*.kt]
ktlint = disabled
