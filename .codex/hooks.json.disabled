{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); case \"$cmd\" in *\"git commit\"*) root=$(git rev-parse --show-toplevel) && cd \"$root\" && ./gradlew ktlintCheck 2>&1 | tail -20 ;; esac",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.kt|*.kts) root=$(git rev-parse --show-toplevel) && cd \"$root\" && ./gradlew ktlintFormat 2>&1 | tail -5 ;; esac",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
